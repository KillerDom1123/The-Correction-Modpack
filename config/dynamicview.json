{
  "minChunkViewDist": {
    // The minimum chunk view distance allowed to use. 
    // Default: 10, minimum 3, maximum 200
    "minChunkViewDist": 8
  },

  "maxChunkViewDist": {
    // The maximum chunk view distance allowed to use. Set to the max a player could benefit from. 
    // Default: 10, minimum 3, maximum 200
    "maxChunkViewDist": 12
  },

  "meanAvgTickTime": {
    // The average tick time to stabilize the distances around. Setting it higher than 50ms is not advised,
    // as after 50ms the TPS will go below 20. 
    // Default: 45ms, min: 10, max:100
    "meanAvgTickTime": 40
  },

  "viewDistanceUpdateRate": {
    // The change frequency of distances in seconds. 
    // Default: 30, min:1, max:1000
    "viewDistanceUpdateRate": 60
  },

  "minSimulationDist": {
    // The minimum simulation distance allowed to use. 
    // Default: 4, minimum 1, maximum 200
    "minSimulationDist": 6
  },

  "maxSimulationDist": {
    // The maximum simulation distance allowed to use. 
    // Default: 10, minimum 1, maximum 200
    "maxSimulationDist": 8
  },

  "adjustSimulationDistance": {
    // Enables automatic simulation distance adjustment. 
    // Default: true
    "adjustSimulationDistance": true
  },

  "logMessages": {
    // Whether to output log messages for actions done. This can be helpful to balance the other settings nicely.
    // Default = false
    "logMessages": true
  }
}
