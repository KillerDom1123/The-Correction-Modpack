				{ count: 16, id: "7A01000000000306", item: "minecraft:torch", type: "item" }
			]
			shape: "hexagon"
			size: 1.5d
			subtitle: "A World Left Behind"
			tasks: [
				{ id: "7A01000000000201", structure: "#oldcivilisation:abandoned_places", title: "Stand inside an abandoned place: a ruin, a dungeon or an empty building", type: "structure" }
