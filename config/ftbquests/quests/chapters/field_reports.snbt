				{ id: "7A05000000000322", item: "minecraft:clock", type: "item" }
			]
			subtitle: "It Was Not There Before"
			tasks: [{ id: "7A0500000000020A", item: "oldcivilisation:temporal_residue", type: "item" }]
			x: 8.0d
			y: -1.5d
		}
		{
			dependencies: ["7A05000000000104"]
			description: [
				"&8[ FIELD REPORT — BELOW THE BEDROCK ]&r"
				""
				"&7The oldest warnings point down, and down did not stop at bedrock. Under the ancient cities there is a door, and on the far side a world that sound does not leave.&r"
				""
				"&8Objective: pass through to the Otherside and find one of its temples. Quietly.&r"
			]
			icon: "minecraft:sculk_shrieker"
			id: "7A0500000000010B"
			rewards: [
