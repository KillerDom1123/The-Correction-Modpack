		{
			dependencies: ["7A05000000000101"]
			description: [
				"&8[ FIELD REPORT — ONGOING ]&r"
				""
				"&7I stayed out. Nowhere near a bed, a colony or any walls that mean anything. Ten nights. By the fourth I was certain I was not being hunted.&r"
				""
				"&7I was being observed.&r"
				""
				"&7\"Something has noticed the return of civilisation.\"&r"
			]
			id: "7A05000000000106"
			rewards: [
				{ id: "7A05000000000317", type: "xp", xp: 30 }
				{ id: "7A05000000000318", item: "artifacts:running_shoes", type: "item" }
				{ id: "7A05000000000319", item: "comforts:sleeping_bag_red", type: "item" }
				{ count: 4, id: "7A0500000000031A", item: "farmersdelight:vegetable_soup", type: "item" }
			]
			subtitle: "The Watchers"
			tasks: [
				{ id: "7A05000000000206", stage: "oc_q_watchers", title: "Survive ten whole nights away from home: 256+ blocks from spawn and from your bed, outside any colony", type: "gamestage" }
			]
			x: 2.5d
			y: 2.0d
		}
		{
			dependencies: ["7A05000000000101"]
			description: [
				"&8[ FIELD REPORT — IT WEARS FACES ]&r"
				""
				"&7Witnesses describe a thing that is almost right. It reproduces a shape, a voice, a habit — and gets one detail wrong, always. Whatever is left behind after it is dealt with does not stay one shape for long.&r"
				""
				"&8Objective: recover a Distorted Replica. Survive an encounter, or end one.&r"
			]
			hide_dependency_lines: true
			icon: "oldcivilisation:distorted_replica"
			id: "7A05000000000107"
			optional: true
			rewards: [
				{ id: "7A0500000000031B", type: "xp", xp: 30 }
				{ count: 8, id: "7A0500000000031C", item: "minecraft:paper", type: "item" }
