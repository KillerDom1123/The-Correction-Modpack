			x: 6.5d
			y: 2.5d
		}
		{
			dependencies: ["7A05000000000106"]
			description: [
				"&8[ FIELD REPORT — THE BREATHLESS ]&r"
				""
				"&7Every account agrees that it noticed them first, from further away than anything should see. Doors did not slow it. Survivors describe the air going thin around it. Where it has been it leaves a residue our instruments cannot name, and it does not disperse.&r"
				""
				"&8Objective: recover Breathless Residue. Survive an encounter, or end one.&r"
			]
			hide_dependency_lines: true
			icon: "oldcivilisation:fog_residue"
			id: "7A05000000000109"
			optional: true
			rewards: [
				{ id: "7A0500000000031F", type: "xp", xp: 30 }
				{ count: 2, id: "7A05000000000320", item: "farmersdelight:vegetable_soup", type: "item" }
			]
			subtitle: "The Breathless"
			tasks: [{ id: "7A05000000000209", item: "oldcivilisation:fog_residue", type: "item" }]
			x: 2.5d
			y: 3.5d
		}
		{
			dependencies: ["7A05000000000101"]
			description: [
				"&8[ FIELD REPORT — IT WAS NOT THERE BEFORE ]&r"
				""
				"&7Do not look away. Every account repeats the same rule, underlined. The object it leaves reads as older each time it is measured, though it has sat untouched on the bench.&r"
				""
				"&8Objective: recover Temporal Residue. Survive an encounter, or end one.&r"
			]
			hide_dependency_lines: true
			icon: "oldcivilisation:temporal_residue"
