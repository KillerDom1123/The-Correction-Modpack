			dependency_requirement: "all_completed"
			description: [
				"&8[ SUMMARY — ALL DISCIPLINES ]&r"
				""
				"&7I have compared the four investigations side by side. Technology. Knowledge. Understanding. Observation.&r"
				""
				"&7They do not contradict each other. They fit together, like sections of one report written by four people who never met.&r"
				""
				"&8We have rebuilt everything the people before us had. All of it. At the same time.&r"
				""
				"&8I no longer think that is a coincidence.&r"
