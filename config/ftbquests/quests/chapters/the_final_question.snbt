				{ count: 8, id: "7A07000000000304", item: "ad_astra:steel_ingot", type: "item" }
			]
			subtitle: "The Departure Records"
			tasks: [
				{ id: "7A07000000000201", item: "oldcivilisation:flight_recorder_launch", type: "item" }
				{ id: "7A07000000000209", item: "oldcivilisation:flight_recorder_transit", type: "item" }
				{ id: "7A0700000000020A", item: "oldcivilisation:flight_recorder_arrival", type: "item" }
