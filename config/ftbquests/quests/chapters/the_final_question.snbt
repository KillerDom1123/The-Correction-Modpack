			dependency_requirement: "all_completed"
			description: [
				"&8[ ASSEMBLED FROM MULTIPLE FRAGMENTS ]&r"
				""
				"&7I have collected enough of the removed records to reconstruct their final months. It does not read like the end of a war.&r"
				""
				"&7It reads like preparation.&r"
				""
				"&7\"They did not fight.\"&r"
				"&7\"They prepared.\"&r"
				""
				"&8Prepared for what? I found these fragments where they went. Not where they came from.&r"
			]
			id: "7A07000000000101"
			rewards: [
				{ id: "7A07000000000301", type: "xp", xp: 40 }
				{ id: "7A07000000000302", type: "xp_levels", xp_levels: 2 }
